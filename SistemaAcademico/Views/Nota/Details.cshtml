@model SistemaAcademico.Models.Nota
@{
    ViewData["Title"] = "Detalles Nota";
}

<div class="card">
    <div class="card-header">
        <h4 class="mb-0"><i class="fas fa-eye me-2"></i>Detalles de la Nota</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Estudiante</dt>
            <dd class="col-sm-9">@(Model.Inscripcion?.Estudiante != null ? Model.Inscripcion.Estudiante.Nombre + " " + Model.Inscripcion.Estudiante.Apellido : "N/A")</dd>
            <dt class="col-sm-3">Materia</dt>
            <dd class="col-sm-9">@(Model.Inscripcion?.Materia != null ? Model.Inscripcion.Materia.Nombre : "N/A")</dd>
            <dt class="col-sm-3">Nota 1</dt>
            <dd class="col-sm-9">@Model.Nota1</dd>
            <dt class="col-sm-3">Nota 2</dt>
            <dd class="col-sm-9">@Model.Nota2</dd>
            <dt class="col-sm-3">Nota Final</dt>
            <dd class="col-sm-9">@Model.NotaFinal</dd>
        </dl>
        <a asp-action="Edit" asp-route-id="@Model.NotaID" class="btn btn-warning">
            <i class="fas fa-edit me-1"></i>Editar
        </a>
        <a asp-action="Index" class="btn btn-secondary ms-2">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>