@model SistemaAcademico.Models.Nota
@{
    ViewData["Title"] = "Editar Nota";
}

<div class="card">
    <div class="card-header">
        <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Editar Nota</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="NotaID" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="InscripcionID" class="form-label">Inscripción</label>
                    <select asp-for="InscripcionID" class="form-select">
                        <option value="">-- Seleccione una inscripción --</option>
                        @foreach (var i in ViewBag.Inscripciones)
                        {
                            <option value="@i.InscripcionID">@i.Estudiante.Nombre @i.Estudiante.Apellido - @i.Materia.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Nota1" class="form-label"></label>
                    <input asp-for="Nota1" class="form-control" type="number" step="0.01" min="0" max="10" />
                    <span asp-validation-for="Nota1" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Nota2" class="form-label"></label>
                    <input asp-for="Nota2" class="form-control" type="number" step="0.01" min="0" max="10" />
                    <span asp-validation-for="Nota2" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Guardar
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="fas fa-arrow-left me-1"></i>Cancelar
            </a>
        </form>
    </div>
</div>