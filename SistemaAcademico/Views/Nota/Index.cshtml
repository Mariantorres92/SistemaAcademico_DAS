@model IEnumerable<SistemaAcademico.Models.Nota>
@{
    ViewData["Title"] = "Notas";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="fas fa-star me-2"></i>Gestión de Notas</h4>
        <a asp-action="Create" class="btn btn-light btn-sm">
            <i class="fas fa-plus me-1"></i>Nueva Nota
        </a>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Estudiante</th>
                    <th>Materia</th>
                    <th>Nota 1</th>
                    <th>Nota 2</th>
                    <th>Nota Final</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.Inscripcion?.Estudiante != null ? item.Inscripcion.Estudiante.Nombre + " " + item.Inscripcion.Estudiante.Apellido : "N/A")</td>
                        <td>@(item.Inscripcion?.Materia != null ? item.Inscripcion.Materia.Nombre : "N/A")</td>
                        <td>@item.Nota1</td>
                        <td>@item.Nota2</td>
                        <td>@item.NotaFinal</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.NotaID" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.NotaID" class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.NotaID" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>