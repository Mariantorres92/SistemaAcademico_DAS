@model SistemaAcademico.Models.Estudiante
@{
    ViewData["Title"] = "Editar Estudiante";
}

<div class="card">
    <div class="card-header">
        <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Editar Estudiante</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="EstudianteID" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Carnet" class="form-label"></label>
                    <input asp-for="Carnet" class="form-control" />
                    <span asp-validation-for="Carnet" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Apellido" class="form-label"></label>
                    <input asp-for="Apellido" class="form-control" />
                    <span asp-validation-for="Apellido" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Correo" class="form-label"></label>
                    <input asp-for="Correo" class="form-control" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Carrera" class="form-label"></label>
                    <input asp-for="Carrera" class="form-control" />
                    <span asp-validation-for="Carrera" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-check">
                        <input asp-for="Activo" class="form-check-input" />
                        <label asp-for="Activo" class="form-check-label">Activo</label>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Guardar
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="fas fa-arrow-left me-1"></i>Cancelar
            </a>
        </form>
    </div>
</div>