@model SistemaAcademico.Models.Materia
@{
    ViewData["Title"] = "Editar Materia";
}

<div class="card">
    <div class="card-header">
        <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Editar Materia</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="MateriaID" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Codigo" class="form-label"></label>
                    <input asp-for="Codigo" class="form-control" />
                    <span asp-validation-for="Codigo" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Creditos" class="form-label"></label>
                    <input asp-for="Creditos" class="form-control" />
                    <span asp-validation-for="Creditos" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ProfesorID" class="form-label">Profesor</label>
                    <select asp-for="ProfesorID" class="form-select">
                        <option value="">-- Seleccione un profesor --</option>
                        @foreach (var p in ViewBag.Profesores)
                        {
                            <option value="@p.ProfesorID">@p.Nombre @p.Apellido</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-check">
                        <input asp-for="Activo" class="form-check-input" />
                        <label asp-for="Activo" class="form-check-label">Activo</label>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Guardar
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="fas fa-arrow-left me-1"></i>Cancelar
            </a>
        </form>
    </div>
</div>