@model SistemaAcademico.Models.Inscripcion
@{
    ViewData["Title"] = "Detalles Inscripción";
}

<div class="card">
    <div class="card-header">
        <h4 class="mb-0"><i class="fas fa-eye me-2"></i>Detalles de la Inscripción</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Estudiante</dt>
            <dd class="col-sm-9">@(Model.Estudiante != null ? Model.Estudiante.Nombre + " " + Model.Estudiante.Apellido : "N/A")</dd>
            <dt class="col-sm-3">Materia</dt>
            <dd class="col-sm-9">@(Model.Materia != null ? Model.Materia.Nombre : "N/A")</dd>
            <dt class="col-sm-3">Ciclo</dt>
            <dd class="col-sm-9">@Model.Ciclo</dd>
            <dt class="col-sm-3">Fecha Inscripción</dt>
            <dd class="col-sm-9">@Model.FechaInscripcion.ToString("dd/MM/yyyy")</dd>
        </dl>
        <a asp-action="Edit" asp-route-id="@Model.InscripcionID" class="btn btn-warning">
            <i class="fas fa-edit me-1"></i>Editar
        </a>
        <a asp-action="Index" class="btn btn-secondary ms-2">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>