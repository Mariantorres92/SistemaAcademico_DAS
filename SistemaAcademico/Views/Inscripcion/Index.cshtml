@model IEnumerable<SistemaAcademico.Models.Inscripcion>
@{
    ViewData["Title"] = "Inscripciones";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="fas fa-clipboard-list me-2"></i>Gestión de Inscripciones</h4>
        <a asp-action="Create" class="btn btn-light btn-sm">
            <i class="fas fa-plus me-1"></i>Nueva Inscripción
        </a>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Estudiante</th>
                    <th>Materia</th>
                    <th>Ciclo</th>
                    <th>Fecha Inscripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.Estudiante != null ? item.Estudiante.Nombre + " " + item.Estudiante.Apellido : "N/A")</td>
                        <td>@(item.Materia != null ? item.Materia.Nombre : "N/A")</td>
                        <td>@item.Ciclo</td>
                        <td>@item.FechaInscripcion.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.InscripcionID" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.InscripcionID" class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.InscripcionID" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>